rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == "admin";
    }

    function inSchool(schoolId) {
      return isSignedIn() && myProfile().schoolId == schoolId && myProfile().get('banned', false) != true;
    }

    function inClass(schoolId, classId) {
      return isSignedIn()
        && myProfile().schoolId == schoolId
        && myProfile().classId == classId
        && myProfile().get('banned', false) != true;
    }

    // Same school + class as the profile doc being read — this is what lets
    // the leaderboard query (users where schoolId==X && classId==Y) actually
    // return results; without it, classmates couldn't see each other's XP/rank.
    function sameClassAsTarget(targetData) {
      return isSignedIn()
        && myProfile().schoolId == targetData.schoolId
        && myProfile().classId == targetData.classId
        && myProfile().get('banned', false) != true;
    }

    // ============================================================
    // users/{uid}
    // ============================================================
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        sameClassAsTarget(resource.data)
      );
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.get('banned', false) == resource.data.get('banned', false))
      );
      allow delete: if isAdmin();

      // Personal upload history mirror — written alongside the real entry doc
      // in the same transaction, so a student's own "My Uploads" page doesn't
      // need a cross-school collectionGroup query (which rules can't safely
      // scope here). Strictly private to the owner (and admin).
      match /myUploads/{uploadId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ============================================================
    // schools/{schoolId}
    // ============================================================
    match /schools/{schoolId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.name is string;

      allow update, delete: if isAdmin();

      // ==========================================================
      // schools/{schoolId}/classes/{classId}
      // ==========================================================
      match /classes/{classId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
                      && request.resource.data.name is string
                      && request.resource.data.session is string;

        allow update, delete: if isAdmin();

        // ========================================================
        // .../subjects/{subjectId}
        // Any signed-in classmate can ADD a subject (self-service) and
        // can now EDIT its name/teacher too (e.g. filling in a teacher's
        // name someone left blank) — deleting a subject the whole class
        // depends on stays admin-only so it can't be removed by mistake.
        // ========================================================
        match /subjects/{subjectId} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow create: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.name is string
                          && request.resource.data.name.size() > 0
                        );
          allow update: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.name is string
                          && request.resource.data.name.size() > 0
                        );
          allow delete: if isAdmin();

          // ======================================================
          // .../entries/{entryId}  <- day-by-day uploads, one doc
          // per subject per date (id = "YYYY-MM-DD"), collaboratively
          // added to by any classmate. Chapters layer dropped for MVP —
          // easy to reintroduce later if per-chapter grouping is needed.
          // ======================================================
          match /entries/{entryId} {
            allow read: if inClass(schoolId, classId) || isAdmin();
            allow create: if isAdmin() || (
                            inClass(schoolId, classId)
                            && request.auth.uid in request.resource.data.uploadedBy
                          );
            // Collaborative: any classmate can update (append their own photos/uid),
            // not just the original uploader — that's the whole point of the shared
            // entry doc. We can't easily enforce "only appended, not removed" with
            // rules alone here, so this trusts class membership as the boundary.
            allow update: if inClass(schoolId, classId) || isAdmin();
            allow delete: if isAdmin();
          }
        }

        // ========================================================
        // .../homework/{hwId}  <- simple homework tracker, any classmate
        // can post an item, each student tracks their own completion in a
        // small subcollection keyed by their own uid.
        // ========================================================
        match /homework/{hwId} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow create: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.createdBy == request.auth.uid
                        );
          allow update, delete: if isAdmin()
                        || (inClass(schoolId, classId) && resource.data.createdBy == request.auth.uid);

          match /completedBy/{uid} {
            allow read: if inClass(schoolId, classId) || isAdmin();
            allow write: if inClass(schoolId, classId) && request.auth.uid == uid;
          }
        }
      }
    }
  }
}
