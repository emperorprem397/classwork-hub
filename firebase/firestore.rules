rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == "admin";
    }

    function inSchool(schoolId) {
      return isSignedIn() && myProfile().schoolId == schoolId && myProfile().get('banned', false) != true;
    }

    function inClass(schoolId, classId) {
      return isSignedIn()
        && myProfile().schoolId == schoolId
        && myProfile().classId == classId
        && myProfile().get('banned', false) != true;
    }

    // Same school + class as the profile doc being read — this is what lets
    // the leaderboard query (users where schoolId==X && classId==Y) actually
    // return results; without it, classmates couldn't see each other's XP/rank.
    function sameClassAsTarget(targetData) {
      return isSignedIn()
        && myProfile().schoolId == targetData.schoolId
        && myProfile().classId == targetData.classId
        && myProfile().get('banned', false) != true;
    }

    // ============================================================
    // users/{uid}
    // ============================================================
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        sameClassAsTarget(resource.data)
      );
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.get('banned', false) == resource.data.get('banned', false))
      );
      // Self-delete needed for Settings → "Start fresh": a student can wipe
      // their own profile doc to reset onboarding, XP, streak, school/class.
      // ensureUserProfile() in auth.js recreates a brand-new doc (with
      // onboarded: false) the next time this same account signs in.
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      // Personal upload history mirror — written alongside the real entry doc
      // in the same transaction, so a student's own "My Uploads" page doesn't
      // need a cross-school collectionGroup query (which rules can't safely
      // scope here). Strictly private to the owner (and admin).
      match /myUploads/{uploadId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ============================================================
    // schools/{schoolId}
    // ============================================================
    match /schools/{schoolId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.name is string;

      allow update, delete: if isAdmin();

      // ==========================================================
      // schools/{schoolId}/classes/{classId}
      // ==========================================================
      match /classes/{classId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
                      && request.resource.data.name is string
                      && request.resource.data.session is string;

        allow update, delete: if isAdmin();

        // ========================================================
        // .../subjects/{subjectId}
        // Any signed-in classmate can ADD, EDIT (name/teacher), and now
        // DELETE a subject — classes vary a lot (Science stream vs. Arts
        // stream, different electives), so students shouldn't be stuck
        // with subjects that don't apply to them just waiting on an admin.
        // Every create/edit/delete is also mirrored into the activity log
        // below, so it's never silent — everyone (admin included) can see
        // who removed or changed what.
        // ========================================================
        match /subjects/{subjectId} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow create: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.name is string
                          && request.resource.data.name.size() > 0
                        );
          allow update: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.name is string
                          && request.resource.data.name.size() > 0
                        );
          allow delete: if isAdmin() || inClass(schoolId, classId);

          // ======================================================
          // .../entries/{entryId}  <- day-by-day uploads, one doc
          // per subject per date (id = "YYYY-MM-DD"), collaboratively
          // added to by any classmate. Chapters layer dropped for MVP —
          // easy to reintroduce later if per-chapter grouping is needed.
          // ======================================================
          match /entries/{entryId} {
            allow read: if inClass(schoolId, classId) || isAdmin();
            allow create: if isAdmin() || (
                            inClass(schoolId, classId)
                            && request.auth.uid in request.resource.data.uploadedBy
                          );
            // Collaborative: any classmate can update (append their own photos/uid),
            // not just the original uploader — that's the whole point of the shared
            // entry doc. We can't easily enforce "only appended, not removed" with
            // rules alone here, so this trusts class membership as the boundary.
            allow update: if inClass(schoolId, classId) || isAdmin();
            allow delete: if isAdmin();
          }
        }

        // ========================================================
        // .../activity/{activityId}  <- append-only class activity log.
        // Written alongside subject create/edit/delete and every upload
        // (see helpers.js logActivity()) so the whole class — admin
        // included — can see who did what and when. Nobody can edit or
        // remove an existing entry (immutable log); admin can still delete
        // if something needs moderating.
        // ========================================================
        match /activity/{activityId} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow create: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.actorUid == request.auth.uid
                        );
          allow update: if false;
          allow delete: if isAdmin();
        }

        // ========================================================
        // .../messages/{messageId}  <- real-time Class Chat. Ordered by
        // createdAt, listened to live via onSnapshot (not polled) so
        // messages appear for every classmate within roughly the same
        // second they're sent — see js/activity.js. Hard-deleted on
        // removal (no "message deleted" placeholder, kept simple); only
        // the author (or admin) can edit/delete their own message.
        // ========================================================
        match /messages/{messageId} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow create: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.uid == request.auth.uid
                          && request.resource.data.text is string
                          && request.resource.data.text.size() > 0
                          && request.resource.data.text.size() <= 2000
                        );
          allow update: if isAdmin() || (
                          inClass(schoolId, classId) && resource.data.uid == request.auth.uid
                        );
          allow delete: if isAdmin() || (
                          inClass(schoolId, classId) && resource.data.uid == request.auth.uid
                        );
        }

        // ========================================================
        // .../typing/{uid}  <- ephemeral "is typing…" presence, one doc
        // per user, overwritten every couple seconds while they're
        // actively typing in Class Chat. Each student can only write
        // their own doc.
        // ========================================================
        match /typing/{uid} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow write: if inClass(schoolId, classId) && request.auth.uid == uid;
        }

        // ========================================================
        // .../homework/{hwId}  <- simple homework tracker, any classmate
        // can post an item, each student tracks their own completion in a
        // small subcollection keyed by their own uid.
        // ========================================================
        match /homework/{hwId} {
          allow read: if inClass(schoolId, classId) || isAdmin();
          allow create: if isAdmin() || (
                          inClass(schoolId, classId)
                          && request.resource.data.createdBy == request.auth.uid
                        );
          allow update, delete: if isAdmin()
                        || (inClass(schoolId, classId) && resource.data.createdBy == request.auth.uid);

          match /completedBy/{uid} {
            allow read: if inClass(schoolId, classId) || isAdmin();
            allow write: if inClass(schoolId, classId) && request.auth.uid == uid;
          }
        }
      }
    }

    // ============================================================
    // adminMessages/{messageId}  <- Settings → About → "Contact admin".
    // Any signed-in user can send one; only admin can read/manage them
    // (they show up as notifications in the admin panel). The sender can't
    // read them back, edit, or delete once sent — it's a one-way mailbox.
    // ============================================================
    match /adminMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
