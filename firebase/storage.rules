rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Real per-class scoping, now that the upload path shape exists:
    //   notebooks/{schoolId}/{classId}/{subjectId}/{date}/{fileName}
    // Only signed-in members of that exact school+class can read or write
    // files under it — checked by looking up their Firestore profile via
    // firestore.get(), same pattern as inClass() in firestore.rules.
    match /notebooks/{schoolId}/{classId}/{subjectId}/{date}/{fileName} {

      function profile() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      }

      function inClass() {
        return request.auth != null
          && profile().schoolId == schoolId
          && profile().classId == classId
          && profile().banned != true;
      }

      allow read: if inClass();

      allow write: if inClass()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Anything outside notebooks/ is closed — no more blanket "any signed-in
    // user, any path" access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
